VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_spa_client_id
# Required for backend-protected API endpoints.
VITE_AUTH0_AUDIENCE=your_auth0_api_audience
# Add any backend permissions your Auth0 API requires, for example:
# VITE_AUTH0_SCOPE=openid profile email realtime:manage
VITE_AUTH0_SCOPE=openid profile email
VITE_API_BASE_URL=http://127.0.0.1:8000

# Passwordless connection names in your Auth0 tenant.
VITE_AUTH0_EMAIL_CONNECTION=email
VITE_AUTH0_SMS_CONNECTION=sms

# Optional. If omitted, the Google button will rely on the hosted Auth0 flow.
VITE_AUTH0_GOOGLE_CONNECTION=google-oauth2
